POSTGRES_USER=invox_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=invox

WEB_PORT=3000
API_PORT=3001

APP_URL=https://your-domain.example
NEXT_PUBLIC_API_URL=https://your-api-domain.example
CORS_ORIGINS=https://your-domain.example

JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-24-random-characters
ERP_WEBHOOK_SECRET=replace-with-at-least-24-random-characters
EINVOICING_WEBHOOK_SECRET=replace-with-at-least-24-random-characters
WEBHOOK_SIGNING_SECRET=replace-with-at-least-24-random-characters

JWT_EXPIRES_IN=1d
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/storage
SIGNED_URL_EXPIRY_SECONDS=300

PAYMENT_PROVIDER=sandbox
PAYMENT_MODE=sandbox
ENABLE_LIVE_PAYMENTS=false
SANDBOX_PAYMENT_AUTO_SUCCESS=true
SANDBOX_PAYMENT_FAILURE_REFERENCE_PREFIX=FAIL
SANDBOX_PAYMENT_PENDING_REFERENCE_PREFIX=PENDING

ERP_PROVIDER=mock
EINVOICING_PROVIDER=mock
PROVIDER_WEBHOOK_MAX_RETRIES=5
MAX_INVOICE_IMPORT_ROWS=5000
INVOICE_IMPORT_ALLOWED_MIME_TYPES=text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
INVOICE_IMPORT_REQUIRE_BUYER_APPROVAL=true

WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_SECONDS=60

NOTIFICATION_PROVIDER=console
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
DEFAULT_FROM_EMAIL=no-reply@invox.local
DEFAULT_FROM_NAME=INVOX
